# Dawn Code. Copy to /etc/dawn-code/env on the server (mode 0600).
# Never commit real keys. The gateway reads these. The browser extension does not.

# Required. Extension host sends this to the local gateway. Not a model key.
DAWN_CODE_TOKEN=

# Public host. Caddy and oauth2-proxy share one cookie here.
DAWN_PUBLIC_HOST=2-29-173-68.sslip.io
DAWN_CODE_DOMAIN=2-29-173-68.sslip.io

# Folder OpenVSCode opens.
DAWN_CODE_WORKSPACE=/home/kyle/src

# Keep both binds on localhost. Caddy is the public door.
DAWN_CODE_HOST=127.0.0.1
DAWN_CODE_PORT=8791
OPENVSCODE_PORT=3000

# Model keys. At least one is needed for live answers. Missing keys use the stand-in.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Shared monthly cap in USD. Dawn Agents reads the same variable.
DAWN_SPEND_CAP_USD=20

# Dawn Agents gateway (the other app). Stubbed when it is down or the token is empty.
DAWN_AGENTS_URL=http://127.0.0.1:8787
DAWN_EDITOR_TOKEN=

# The gateway sends this email on X-Auth-Request-Email when it forwards training
# rows to Dawn Agents. That header is trusted only from localhost.
# Comma-separated. The code gateway forwards training rows as the first address.
DAWN_ALLOWED_EMAIL=kylesmcauliffe@gmail.com,team@artometrics.com
DAWN_DATA_IMPORT_URL=
DAWN_TRAINING_LOG_URL=
DAWN_TRAINING_LOG_TOKEN=

# 1 forces stand-in answers and skips model calls.
DAWN_CODE_MOCK=0

# Spend ledger directory.
DAWN_CODE_DATA=/var/lib/dawn-code

# 1 opens the sample file and the chat view. Dev only.
DAWN_CODE_DEMO=0
