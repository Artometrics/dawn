rules_version = '2';

// Prototype storage rules for the Artometrics desk.
// Allowlisted verified accounts only. Files live at
// attachments/{contactId}/{fileName}, max 10MB, known types.

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'team@artometrics.com',
          'kylesmcauliffe@gmail.com'
        ];
    }

    function allowedMime(mime) {
      return mime in [
        'image/jpeg', 'image/png', 'image/webp', 'image/gif',
        'image/heic', 'image/heif', 'application/pdf', 'text/plain'
      ];
    }

    match /attachments/{contactId}/{fileName} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && contactId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$')
        && request.resource.size <= 10 * 1024 * 1024
        && allowedMime(request.resource.contentType);
      allow delete: if isAllowed();
    }
  }
}
