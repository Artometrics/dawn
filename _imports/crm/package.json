{
  "name": "artometrics-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43123 --strictPort",
    "build": "tsc -b && vite build --mode production",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 43124 --strictPort",
    "emulators": "npx -y firebase-tools@latest emulators:start --project crm-510519 --only auth,firestore,storage",
    "test": "vitest run",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --project crm-510519 --only firestore,storage \"REQUIRE_RULES=1 npx vitest run tests/rules.test.ts\""
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.61.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
