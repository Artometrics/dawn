<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional Mac worker. Copy to ~/Library/LaunchAgents/ after you edit the
  token and gateway URL. The Mac is a second computer, not the default.
  Sandboxes live in ~/dawn-agents/<agentId>.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.artometrics.dawn-agents</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_REPO/worker</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>REPLACE_WITH_REPO/worker/dawn-worker.mjs</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>DAWN_AGENTS_URL</key>
      <string>https://your-dawn-agents-gateway.example</string>
      <key>DAWN_WORKER_TOKEN</key>
      <string></string>
      <key>DAWN_WORKER_KIND</key>
      <string>mac</string>
    </dict>
  </dict>
</plist>
