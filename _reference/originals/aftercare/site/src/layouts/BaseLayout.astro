---
import '@fontsource-variable/fraunces/full.css'
import '@fontsource-variable/outfit'
import '../styles/almanac.css'
import '../styles/pages.css'
import '../styles/app.css'
import Sprite from '../components/Sprite.astro'
import Icon from '../components/Icon.astro'

interface Props {
  title: string
  description?: string
  active?: 'home' | 'tarot' | 'numerology' | 'profile' | 'journal' | ''
  bodyClass?: string
}
const { title, description = 'Aftercare: tarot, numerology and a map of the things you love, all on your own device.', active = '', bodyClass = '' } = Astro.props
const nav = [
  ['Tarot', '/tarot/', 'tarot'],
  ['Numbers', '/numerology/', 'numerology'],
  ['Second self', '/profile/', 'profile'],
  ['Journal', '/journal/', 'journal'],
] as const
const tabs = [
  ['home', 'Home', '/', 'home'],
  ['cards', 'Tarot', '/tarot/', 'tarot'],
  ['num', 'Numbers', '/numerology/', 'numerology'],
  ['me', 'Me', '/profile/', 'profile'],
  ['book', 'Journal', '/journal/', 'journal'],
] as const
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3ead9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'Aftercare' ? title : `${title} - Aftercare`}</title>
  </head>
  <body class={bodyClass}>
    <Sprite />
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Aftercare home">
          <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="#0f2321"/><path d="M21.5 7.5a9.5 9.5 0 1 0 3 12.5 7.5 7.5 0 0 1-3-12.5z" fill="#d99a2b"/><circle cx="21" cy="12" r="1.3" fill="#f3ead9"/><circle cx="12" cy="9" r=".8" fill="#f3ead9"/></svg>
          Aftercare
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map(([label, href, key]) => <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="head-cta">
          <a class="btn ghost sm" href="/tarot/readings/">My readings</a>
          <a class="btn sm" href="/onboarding/">Start your profile</a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <div>
          <a class="logo" href="/">Aftercare</a>
          <p style="max-width:26em">A warm little almanac for your inner life. Tarot, numbers, places and the things you love, in one home on your own device.</p>
        </div>
        <div>
          <h4>Explore</h4>
          <a href="/tarot/">Tarot table</a>
          <a href="/tarot/cards/">The deck</a>
          <a href="/numerology/">Numerology</a>
          <a href="/profile/">Your second self</a>
        </div>
        <div>
          <h4>Yours</h4>
          <a href="/onboarding/">Edit profile</a>
          <a href="/tarot/readings/">Saved readings</a>
          <a href="/journal/">Journal (soon)</a>
        </div>
        <div>
          <h4>Aftercare</h4>
          <a href="/privacy/">Privacy and your data</a>
          <a href="/share/">Shared profiles</a>
        </div>
        <div class="fine">
          <span>For reflection and entertainment. Readings do not predict the future or replace medical, legal or financial advice.</span>
          <span>Everything stays on this device.</span>
        </div>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Tabs">
      {tabs.map(([icon, label, href, key]) => (
        <a href={href} aria-current={active === key ? 'page' : undefined}><Icon name={icon} /><span>{label}</span></a>
      ))}
    </nav>
  </body>
</html>
