---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Icon from '../../components/Icon.astro'
import { SPREADS, SPREAD_IDS } from '../../lib/spreads'
import { REFLECTION_NOTE } from '../../lib/reading'
---
<BaseLayout title="Tarot table" active="tarot" description="A 3D tarot table: shuffle, deal and flip a 78-card deck with original art. One card, three card or Celtic Cross.">
  <section class="table-sec dark" id="tarot-app">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:22px">
        <span class="eyebrow">The table</span>
        <h1 style="font-size:clamp(2.2rem,5vw,3.6rem)">Pull a few <em>cards.</em></h1>
      </div>
      <div class="toolbar">
        <div class="seg" role="group" aria-label="Spread" id="spread-picker">
          {SPREAD_IDS.map((id) => <button type="button" data-spread={id} aria-pressed={id === 'three' ? 'true' : 'false'}>{SPREADS[id].name}</button>)}
        </div>
        <label class="question">
          <span class="sr">Your question (optional)</span>
          <input id="question" maxlength="200" placeholder="What are you wondering about? (optional)" autocomplete="off" />
        </label>
      </div>
      <p class="spread-blurb" id="spread-blurb">{SPREADS.three.blurb}</p>

      <div class="table-host" id="table" data-spread="three" data-state="idle">
        <p class="table-fallback" id="table-fallback" hidden>This device cannot show the 3D table. You can still draw and read your cards below.</p>
      </div>

      <div class="table-controls">
        <button class="btn gold" type="button" id="btn-deal">Shuffle &amp; deal</button>
        <button class="btn ghost" type="button" id="btn-shuffle">Shuffle</button>
        <button class="btn ghost" type="button" id="btn-reveal" disabled>Reveal all</button>
        <button class="btn ghost" type="button" id="btn-reset" disabled>Start over</button>
      </div>
      <p class="table-status" id="status" role="status" aria-live="polite">Pick a spread, then shuffle and deal. Tap a card to turn it over.</p>
      <p class="hint-line">Tap or click a card to flip it. On a computer, hover to tilt. Reduced-motion settings are respected.</p>

      <article class="plate focus-card" id="focus" hidden aria-live="polite"></article>
    </div>
  </section>

  <section class="reading" id="reading" hidden>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Your reading</span>
        <h2 id="reading-title">A story in <em>a few beats.</em></h2>
        <p class="muted" id="reading-question"></p>
      </div>
      <ol class="reading-list" id="reading-list"></ol>
      <div class="plate summary" id="summary" hidden>
        <h3><Icon name="eye" /> Looking at the whole table</h3>
        <ul id="summary-list"></ul>
      </div>
      <div class="save-bar">
        <label class="field" style="flex:1;min-width:240px">
          <span>Private note (optional)</span>
          <input id="note" maxlength="500" placeholder="Anything you want to remember about this one?" />
        </label>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
          <button class="btn sm" type="button" id="btn-save" disabled>Save reading</button>
          <a class="btn ghost sm" href="/tarot/readings/">My readings</a>
        </div>
      </div>
      <p class="note" id="save-msg" role="status" style="margin-top:14px">Readings are saved on this device only. Turn over every card to save.</p>
      <p class="note" style="margin-top:22px">{REFLECTION_NOTE}</p>
    </div>
  </section>
  <script>
    import '../../scripts/tarotPage'
  </script>
</BaseLayout>
