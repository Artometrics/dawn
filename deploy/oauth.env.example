# Copy to /etc/dawn/oauth.env (mode 0600). Never commit real values.
# Google OAuth client. Authorized redirect URI:
#   https://2-29-173-68.sslip.io/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes, base64. Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=
# The only account that may open /agents, /editor, and the letter admin.
DAWN_ALLOWED_EMAIL=kylesmcauliffe@gmail.com
OAUTH2_PROXY_REDIRECT_URL=https://2-29-173-68.sslip.io/oauth2/callback
DAWN_PUBLIC_HOST=2-29-173-68.sslip.io
# Directory of the static `next build` output.
DAWN_STATIC_ROOT=/var/lib/dawn/out
