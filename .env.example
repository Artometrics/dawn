# Studio gateway only (server). Never commit real keys.
# The village calls Gemini through Firebase AI Logic and does not use these keys.
# Hosted Gemini also needs a Firebase App Check token. The console currently
# rejects calls without one. Dawn shows that error and a stand-in reply.
# Google Gemini API Key (get from https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter API Key for universal routing (Grok, Claude, DeepSeek, etc. from https://openrouter.ai/)
OPENROUTER_API_KEY=

# Direct xAI Grok API Key (optional, if using direct xai instead of OpenRouter)
XAI_API_KEY=
