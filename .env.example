# Studio gateway only (server). Never commit real keys.
# The village calls Gemini through Firebase AI Logic and does not use these keys.
# Hosted Gemini also needs a Firebase App Check token. The console currently
# rejects calls without one. Dawn shows that error and a stand-in reply.
# Google Gemini API Key (get from https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter API Key for universal routing (Grok, Claude, DeepSeek, etc. from https://openrouter.ai/)
OPENROUTER_API_KEY=

# Direct xAI Grok API Key (optional, if using direct xai instead of OpenRouter)
XAI_API_KEY=

# Dawn Agents gateway. Server only. Never commit real values.
# Google accounts that may enter, separated by commas.
DAWN_ALLOWED_EMAIL=kylesmcauliffe@gmail.com,team@artometrics.com
# Local dev without the proxy. Never set this on the public host.
DAWN_ALLOW_LOOPBACK_OWNER=
DAWN_WORKER_TOKEN=
DAWN_EDITOR_TOKEN=
DAWN_SPEND_CAP_USD=20
DAWN_AGENTS_PORT=8787
# Exact browser Origins for owner writes. Comma-separated. Host is not trusted.
# A page on dawn-510519.web.app is a different site from the gateway and is refused.
DAWN_TRUSTED_ORIGINS=https://2-29-173-68.sslip.io,http://127.0.0.1:3000,http://localhost:3000
DAWN_AGENTS_PUBLIC_URL=
# Optional public gateway URL baked into the static app. Leave blank for localhost.
NEXT_PUBLIC_DAWN_AGENTS_URL=
# Mail. The first one that is set is used. Otherwise sends stay in the local console outbox.
DAWN_MAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=
# Synthetic generator. Default is an OpenRouter open model when that key exists.
DAWN_SYNTHETIC_MODEL=
# Directory of chat-format JSONL backfill. Defaults to /workspace/personal-model when present.
DAWN_BACKFILL_DIR=
