{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "dawn-510519",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "redirects": [
      { "source": "/atlas", "destination": "/", "type": 302 },
      { "source": "/town", "destination": "/village?section=village", "type": 302 },
      { "source": "/editor", "destination": "/code", "type": 302 }
    ],
    "rewrites": [
      {
        "source": "/studio",
        "destination": "/studio.html"
      },
      {
        "source": "/atlas",
        "destination": "/atlas.html"
      },
      {
        "source": "/agents",
        "destination": "/agents.html"
      },
      {
        "source": "/letter",
        "destination": "/letter.html"
      },
      {
        "source": "/newsletter",
        "destination": "/newsletter.html"
      },
      {
        "source": "/invoices",
        "destination": "/invoices.html"
      },
      {
        "source": "/contacts",
        "destination": "/contacts.html"
      },
      {
        "source": "/credits",
        "destination": "/credits.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
